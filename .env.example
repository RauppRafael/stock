# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=stock
DB_DEBUG=false

# Default user created by `node ace db:seed`
SEED_USER_EMAIL=admin@stock.local
SEED_USER_PASSWORD=changeme123
SEED_USER_NAME=Admin

# Shopify Admin API (optional — required only to use the /sync page)
#
# Create an app in https://dev.shopify.com → grant the scopes
# read_products, write_products, read_inventory, write_inventory,
# read_locations → install it on your store via Distribution → Custom
# distribution. Then copy the Client ID and Client Secret (shpss_…)
# from the app's credentials screen below. We exchange them for a 24h
# Admin API access token at runtime via the client credentials grant.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-10
